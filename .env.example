BITRIX_PROJECT_ROOT=/absolute/path/to/bitrix/project

# Qdrant connection & collection
BITRIX_RAG_QDRANT_URL=http://localhost:6333
BITRIX_RAG_QDRANT_COLLECTION=bitrix_code_mvp_sparse

# Dense embedding model (fastembed)
BITRIX_RAG_DENSE_MODEL=BAAI/bge-small-en-v1.5

# Dense large model prefix. For small models set empty
# BITRIX_RAG_QUERY_PREFIX=query: 
# BITRIX_RAG_DOCUMENT_PREFIX=passage: 